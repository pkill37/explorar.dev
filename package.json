{
  "name": "gitshaman.com",
  "version": "1.0.0",
  "description": "A Git companion for exploring source code",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "prepare:sqljs": "tsx scripts/prepare-public-assets.ts --sqljs",
    "corpus:sync": "tsx scripts/download-repos.ts --depth=1",
    "corpus:sync:fast": "EXPLORAR_SKIP_SEMANTIC_ENRICHMENT=1 tsx scripts/download-repos.ts --depth=1",
    "corpus:check-indexes": "tsx scripts/check-corpus-indexes.ts",
    "corpus:prepare-compilation-databases": "tsx scripts/prepare-compilation-databases.ts",
    "corpus:query": "tsx scripts/query-code-index.ts",
    "guides:generate": "tsx scripts/generate-guide-registry.ts",
    "guides:refs": "tsx scripts/check-guide-refs.ts",
    "guides:format": "prettier --config prettier.config.mjs --write docs/*.md CONTRIBUTING.md",
    "guides:validate": "npm run guides:generate && npm run lint:markdown && npm run lint:guide-prose && tsx scripts/validate-guides.ts && npm run guides:refs",
    "dev:prepare": "npm run guides:generate && npm run corpus:sync && tsx scripts/build-man-pages.ts && tsx scripts/prepare-public-assets.ts --dev --sqljs",
    "dev": "next dev --turbopack --port 3000",
    "dev:full": "npm run dev:prepare && npm run dev",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "serve": "serve -l 3000 out -c",
    "serve:public": "serve -l 3000 public",
    "deploy:r2": "tsx scripts/deploy-r2.ts",
    "deploy": "npm run build && tsx scripts/deploy.ts",
    "clean": "rm -rf repos man-pages public/repos public/man-pages public/sqljs public/public-stage-manifest.json out .next .eslintcache",
    "lint": "npm run lint:types && npm run lint:eslint && npm run lint:prettier && npm run lint:markdown && npm run lint:guide-prose && npm run lint:deps",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache --max-warnings 0",
    "lint:prettier": "prettier --config prettier.config.mjs --check .",
    "lint:markdown": "markdownlint docs/*.md --ignore docs/_template.md",
    "lint:guide-prose": "node scripts/lint-guide-prose.mjs",
    "lint:deps": "depcheck --ignores @tailwindcss/postcss,@types/react-dom,raw-loader,tailwindcss",
    "lint:audit": "npm audit",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --config prettier.config.mjs --write .",
    "test": "npm run test:lint && npm run prepare:sqljs && playwright test",
    "test:lint": "node --import tsx --test tests/*.test.mjs tests/*.node.ts",
    "test:report": "playwright show-report out/playwright-report",
    "test:sanity": "npm run prepare:sqljs && playwright test tests/sanity.spec.ts",
    "test:performance": "EXPLORAR_SKIP_CORPUS_BUILD=1 npm run build && npm run test:performance:budget && PERFORMANCE_BUILD=1 playwright test tests/web-vitals.spec.ts",
    "test:performance:budget": "tsx scripts/check-performance-budget.ts",
    "test:seo": "npm run prepare:sqljs && playwright test tests/seo.spec.ts",
    "test:quality": "npm run prepare:sqljs && playwright test tests/quality.spec.ts",
    "test:ui": "npm run prepare:sqljs && playwright test --ui"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@giscus/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "new-github-issue-url": "^1.1.0",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "husky": "^9.1.7",
    "markdownlint-cli": "^0.49.1",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.53.0",
    "new-github-issue-url": "^1.1.0",
    "next": "^16.3.5",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "serve": "^14.2.6",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "write-good": "^1.0.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
